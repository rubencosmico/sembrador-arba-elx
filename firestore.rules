rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: admins/{userId}
    // Fields:
    //   - email: string (optional)
    //   - assignedAt: timestamp (optional)
    //   - assignedBy: string (optional)
    //
    // Collection: users/{userId}
    // Note: Currently stores profile fields alongside email/fcmToken for
    // SocialView, CampaignDashboard, and CampaignManager compatibility.
    // Recommended follow-up: split private PII (email, fcmToken) into a
    // private subcollection so public profiles remain strictly PII-free.
    // Fields:
    //   - displayName: string (required, 1..150 chars)
    //   - defaultRole: string (required, 'sower' on self-create; immutable for non-admins)
    //   - email: string | null (optional, <= 320 chars; immutable for non-admins)
    //   - photoURL: string | null (optional, valid http/https URL <= 2048 chars)
    //   - bio: string | null (optional, <= 1000 chars)
    //   - website: string | null (optional, '' or valid http/https URL <= 500 chars)
    //   - instagram: string | null (optional, <= 200 chars)
    //   - fcmToken: string | null (optional, <= 512 chars)
    //   - createdAt: timestamp (optional, immutable for non-admins)
    //
    // Collection: messages/{messageId}
    // Fields:
    //   - senderId: string (required, == request.auth.uid on create)
    //   - receiverId: string (required, 1..128 chars)
    //   - type: string (required, 'text' | 'reference')
    //   - text: string (required for 'text', 1..500 chars)
    //   - referenceType: string (required for 'reference', 1..50 chars)
    //   - referenceId: string (required for 'reference', 1..128 chars)
    //   - createdAt: timestamp (required)
    //
    // Collection: follows/{followId} (followId == followerId + '_' + followingId)
    // Fields:
    //   - followerId: string (required, == request.auth.uid)
    //   - followingId: string (required, 1..128 chars, != request.auth.uid)
    //   - createdAt: timestamp (required)
    //
    // Collection: claimRequests/{requestId}
    // Fields:
    //   - userId: string (required, == request.auth.uid on create; immutable)
    //   - userName: string | null (optional, <= 150 chars)
    //   - logIds: list (required, 1..500 items; immutable)
    //   - campaignIds: list (optional on legacy, required on create, <= 100 items; immutable)
    //   - status: string (required, 'pending' on create, 'pending' | 'approved' | 'rejected')
    //   - createdAt: timestamp (optional on legacy, required on create; immutable)
    //
    // Collection: artifacts/{appId}/public/data/campaigns/{campId}
    // Fields:
    //   - name: string (required, 1..200 chars on create, <= 200 on update)
    //   - description: string | null (optional, <= 2000 chars)
    //   - status: string (required, 'active' | 'inactive' | 'archived')
    //   - visibility: string (optional, 'public' | 'private')
    //   - ownerId: string | null (optional for legacy compat; == request.auth.uid on modern create; immutable)
    //   - coordinators: list (optional, <= 100 UIDs; owner/admin only)
    //   - participants: list (optional, <= 1000 UIDs; self-join allowed for non-anonymous users)
    //   - coordinates: latlng | map | null (optional)
    //   - organizationName: string | null (optional, <= 150 chars)
    //   - locationName: string | null (optional, <= 150 chars)
    //   - biome: string | null (optional, <= 100 chars)
    //   - createdAt: timestamp (optional on legacy, required on create; immutable)
    //
    // Collection: artifacts/{appId}/public/data/seeds/{seedId}
    // Fields:
    //   - campaignId: string (required, 1..128 chars; immutable once set)
    //   - species: string (required, 1..200 chars)
    //   - provider: string | null (optional, <= 200 chars)
    //   - treatment: string | null (optional, <= 500 chars)
    //   - totalQuantity: number (optional, 0..1000000)
    //   - remainingQuantity: number | null (optional, 0..1000000)
    //   - quantity: number | string | null (optional, legacy compat)
    //   - photo: string | null (optional, data:image/* or http(s) URL <= 350000 chars)
    //   - assignedSeeds: list (optional, <= 500 items)
    //   - userAssignments: list (optional, <= 500 items)
    //   - deleted: bool (optional)
    //   - createdAt: timestamp (optional on legacy, required on create; immutable)
    //
    // Collection: artifacts/{appId}/public/data/groups/{groupId}
    // Fields:
    //   - campaignId: string (required, 1..128 chars; immutable once set)
    //   - name: string (required, 1..200 chars)
    //   - assignedSeeds: list (optional, <= 500 items)
    //   - createdAt: timestamp (optional on legacy, required on create; immutable)
    //
    // Collection: artifacts/{appId}/public/data/logs/{logId}
    // Fields:
    //   - campaignId: string (required, 1..128 chars; immutable for non-admins)
    //   - seedId: string | null (required on create, 1..128 chars)
    //   - seedName: string | null (required on create, 1..200 chars)
    //   - holeCount: int (required on create, 1..1000)
    //   - quantity: string | number | null (optional, <= 50 chars or 0..10000)
    //   - microsite: string | null (optional, <= 100 chars)
    //   - orientation: string | null (optional, <= 50 chars)
    //   - withSubstrate: bool | null (optional)
    //   - withProtector: bool | null (optional)
    //   - notes: string | null (optional, <= 2000 chars)
    //   - location: latlng | map | null (optional)
    //   - photoUrl: string | null (optional, '' | 'PENDING' | http(s) URL <= 2048 chars)
    //   - syncStatus: string | null (optional, 'synced' | 'pending_photo')
    //   - groupId: string | null (optional, <= 128 chars)
    //   - groupName: string | null (optional, <= 150 chars)
    //   - userId: string | null (required == request.auth.uid on create; immutable for non-admins)
    //   - ownerId: string | null (optional, null or == request.auth.uid on create; immutable for non-admins)
    //   - userName: string | null (optional, <= 150 chars)
    //   - timestamp: timestamp (required on create; immutable for non-admins)
    //   - updatedAt: timestamp | null (optional)
    //   - lastCheckupStatus: string | null (optional, 'alive' | 'dormant' | 'dead' | 'predated' | 'not_found')
    //   - lastCheckupAt: timestamp | null (optional)
    //   - lastSurvivingCount: int | null (optional, 0..1000)
    //   - lastGrowthStage: string | null (optional, 'cotyledons' | 'seedling' | 'juvenile' | 'established')
    //   - checkupCount: int | null (optional, 0..10000)
    //   - lastCheckupBy: string | null (optional, <= 150 chars)
    //   - photo, uid, method: legacy fields preserved read-only on existing docs (deletable, never creatable/editable)
    //
    // Collection: artifacts/{appId}/public/data/checkups/{checkupId}
    // Fields:
    //   - campaignId: string (required, 1..128 chars; immutable)
    //   - logId: string (required, 1..128 chars; immutable)
    //   - status: string (required, 'alive' | 'dormant' | 'dead' | 'predated' | 'not_found')
    //   - survivingCount: int | null (optional, 0..1000)
    //   - growthStage: string | null (optional, 'cotyledons' | 'seedling' | 'juvenile' | 'established')
    //   - causes: list | null (optional, <= 10 strings of 1..100 chars)
    //   - notes: string | null (optional, <= 2000 chars)
    //   - photoUrl: string | null (optional, '' or http(s) URL <= 2048 chars)
    //   - reviewerId: string (required, 1..128 chars, == request.auth.uid on create; immutable)
    //   - reviewerName: string | null (optional, <= 150 chars)
    //   - timestamp: timestamp (required; immutable)
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isAnonymous() {
      return isSignedIn() &&
             'firebase' in request.auth.token &&
             'sign_in_provider' in request.auth.token.firebase &&
             request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function isRealUser() {
      return isSignedIn() && !isAnonymous();
    }

    function hasAdminDoc() {
      return exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isAdmin() {
      return isRealUser() && hasAdminDoc();
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isRealOwner(userId) {
      return isRealUser() && request.auth.uid == userId;
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function areImmutableFieldsUnchanged(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    function validString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    function isValidUrl(url) {
      return url is string &&
             (url.matches("^https://.*") || url.matches("^http://.*"));
    }

    // ===============================================================
    // Campaign & Ownership Helpers (Null-Safe)
    // ===============================================================

    function campaignExists(appId, campaignId) {
      return campaignId is string &&
             campaignId.size() > 0 &&
             exists(/databases/$(database)/documents/artifacts/$(appId)/public/data/campaigns/$(campaignId));
    }

    function getCampaign(appId, campaignId) {
      return get(/databases/$(database)/documents/artifacts/$(appId)/public/data/campaigns/$(campaignId)).data;
    }

    function isLegacyCampaignData(campaign) {
      return !('ownerId' in campaign) || campaign.ownerId == null;
    }

    function isLegacyCampaign(appId, campaignId) {
      return campaignExists(appId, campaignId) &&
             isLegacyCampaignData(getCampaign(appId, campaignId));
    }

    function isCampaignDataManager(campaign) {
      return isLegacyCampaignData(campaign) ||
             (
               isRealUser() && (
                 ('ownerId' in campaign && campaign.ownerId == request.auth.uid) ||
                 ('coordinators' in campaign &&
                  campaign.coordinators is list &&
                  request.auth.uid in campaign.coordinators)
               )
             );
    }

    function isCampaignManager(appId, campaignId) {
      return isSignedIn() &&
             campaignExists(appId, campaignId) &&
             isCampaignDataManager(getCampaign(appId, campaignId));
    }

    function canReviewExistingCampaign(appId, campaignId) {
      let camp = getCampaign(appId, campaignId);
      return hasAdminDoc() ||
             isLegacyCampaignData(camp) ||
             ('ownerId' in camp && camp.ownerId == request.auth.uid) ||
             ('coordinators' in camp && camp.coordinators is list && request.auth.uid in camp.coordinators) ||
             (!('visibility' in camp) || camp.visibility == null || camp.visibility == 'public') ||
             ('participants' in camp && camp.participants is list && request.auth.uid in camp.participants);
    }

    function canReviewCampaign(appId, campaignId) {
      return isRealUser() &&
             campaignExists(appId, campaignId) &&
             canReviewExistingCampaign(appId, campaignId);
    }

    function canManageOrReviewLogCampaign(appId, campaignId, summaryOnly, realUser) {
      let camp = getCampaign(appId, campaignId);
      let isManager = isLegacyCampaignData(camp) ||
                      (
                        realUser && (
                          ('ownerId' in camp && camp.ownerId == request.auth.uid) ||
                          ('coordinators' in camp && camp.coordinators is list && request.auth.uid in camp.coordinators)
                        )
                      );
      return isManager ||
             (
               summaryOnly &&
               realUser &&
               (
                 !('visibility' in camp) || camp.visibility == null || camp.visibility == 'public' ||
                 ('participants' in camp && camp.participants is list && request.auth.uid in camp.participants)
               )
             );
    }

    function isLogOwner(logData) {
      return ('userId' in logData && logData.userId == request.auth.uid) ||
             ('ownerId' in logData && logData.ownerId != null && logData.ownerId == request.auth.uid);
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================

    function isValidUser(data) {
      return data.keys().hasOnly([
               'displayName', 'email', 'photoURL', 'bio',
               'website', 'instagram', 'defaultRole', 'fcmToken', 'createdAt'
             ]) &&
             data.keys().hasAll(['displayName', 'defaultRole']) &&
             validString(data.displayName, 1, 150) &&
             data.defaultRole in ['sower', 'coordinator', 'admin'] &&
             (!('email' in data) || data.email == null || (data.email is string && data.email.size() <= 320)) &&
             (!('photoURL' in data) || data.photoURL == null || data.photoURL == '' || (isValidUrl(data.photoURL) && data.photoURL.size() <= 2048)) &&
             (!('bio' in data) || data.bio == null || (data.bio is string && data.bio.size() <= 1000)) &&
             (!('website' in data) || data.website == null || data.website == '' || (isValidUrl(data.website) && data.website.size() <= 500)) &&
             (!('instagram' in data) || data.instagram == null || (data.instagram is string && data.instagram.size() <= 200)) &&
             (!('fcmToken' in data) || data.fcmToken == null || (data.fcmToken is string && data.fcmToken.size() <= 512)) &&
             (!('createdAt' in data) || data.createdAt is timestamp);
    }

    function isValidMessage(data) {
      return data.keys().hasOnly([
               'senderId', 'receiverId', 'text', 'type',
               'referenceType', 'referenceId', 'createdAt'
             ]) &&
             data.keys().hasAll(['senderId', 'receiverId', 'type', 'createdAt']) &&
             data.senderId is string &&
             data.senderId == request.auth.uid &&
             validString(data.receiverId, 1, 128) &&
             data.type in ['text', 'reference'] &&
             data.createdAt is timestamp &&
             (
               (data.type == 'text' && 'text' in data && validString(data.text, 1, 500)) ||
               (data.type == 'reference' &&
                'referenceType' in data && validString(data.referenceType, 1, 50) &&
                'referenceId' in data && validString(data.referenceId, 1, 128) &&
                (!('text' in data) || data.text == null || (data.text is string && data.text.size() <= 500)))
             );
    }

    function isValidFollow(data, followId) {
      return data.keys().hasOnly(['followerId', 'followingId', 'createdAt']) &&
             data.keys().hasAll(['followerId', 'followingId', 'createdAt']) &&
             data.followerId is string &&
             data.followerId == request.auth.uid &&
             validString(data.followingId, 1, 128) &&
             data.followingId != request.auth.uid &&
             followId == (request.auth.uid + '_' + data.followingId) &&
             data.createdAt is timestamp;
    }

    function isValidClaimRequest(data) {
      return data.keys().hasOnly([
               'userId', 'userName', 'logIds', 'campaignIds', 'status', 'createdAt'
             ]) &&
             data.keys().hasAll(['userId', 'logIds', 'status']) &&
             validString(data.userId, 1, 128) &&
             (!('userName' in data) || data.userName == null || (data.userName is string && data.userName.size() <= 150)) &&
             data.logIds is list && data.logIds.size() >= 1 && data.logIds.size() <= 500 &&
             (!('campaignIds' in data) || (data.campaignIds is list && data.campaignIds.size() <= 100)) &&
             data.status in ['pending', 'approved', 'rejected'] &&
             (!('createdAt' in data) || data.createdAt is timestamp);
    }

    function isValidCoordinatesMap(coords) {
      let lat = coords.get('lat', null);
      let lng = coords.get('lng', null);
      let latitude = coords.get('latitude', null);
      let longitude = coords.get('longitude', null);
      return coords.keys().hasOnly(['lat', 'lng', 'latitude', 'longitude']) &&
             (lat == null || lat is number) &&
             (lng == null || lng is number) &&
             (latitude == null || latitude is number) &&
             (longitude == null || longitude is number);
    }

    function isValidCoordinates(coords) {
      return coords == null ||
             coords is latlng ||
             (coords is map && isValidCoordinatesMap(coords));
    }

    function isValidCampaign(data) {
      let desc = data.get('description', null);
      let ownerId = data.get('ownerId', null);
      let orgName = data.get('organizationName', null);
      let locName = data.get('locationName', null);
      let biome = data.get('biome', null);
      return data.keys().hasOnly([
               'name', 'description', 'createdAt', 'status', 'visibility',
               'ownerId', 'coordinators', 'participants', 'coordinates',
               'organizationName', 'locationName', 'biome'
             ]) &&
             data.keys().hasAll(['name', 'status']) &&
             data.name is string && data.name.size() <= 200 &&
             (desc == null || (desc is string && desc.size() <= 2000)) &&
             data.status in ['active', 'inactive', 'archived'] &&
             (!('visibility' in data) || data.visibility in ['public', 'private']) &&
             (ownerId == null || validString(ownerId, 1, 128)) &&
             (!('coordinators' in data) || (data.coordinators is list && data.coordinators.size() <= 100)) &&
             (!('participants' in data) || (data.participants is list && data.participants.size() <= 1000)) &&
             (!('coordinates' in data) || isValidCoordinates(data.coordinates)) &&
             (orgName == null || (orgName is string && orgName.size() <= 150)) &&
             (locName == null || (locName is string && locName.size() <= 150)) &&
             (biome == null || (biome is string && biome.size() <= 100)) &&
             (!('createdAt' in data) || data.createdAt is timestamp);
    }

    function isValidSelfJoin(newData, oldData) {
      return isRealUser() &&
             newData.diff(oldData).affectedKeys().hasOnly(['participants']) &&
             newData.participants is list &&
             newData.participants.size() <= 1000 &&
             request.auth.uid in newData.participants &&
             (
               (
                 (!('participants' in oldData) || oldData.participants == null) &&
                 newData.participants.size() == 1
               ) ||
               (
                 'participants' in oldData &&
                 oldData.participants is list &&
                 newData.participants.hasAll(oldData.participants) &&
                 (
                   (request.auth.uid in oldData.participants &&
                    newData.participants.size() == oldData.participants.size()) ||
                   (!(request.auth.uid in oldData.participants) &&
                    newData.participants.size() == oldData.participants.size() + 1)
                 )
               )
             );
    }

    function isValidSeed(data) {
      let provider = data.get('provider', null);
      let treatment = data.get('treatment', null);
      let remaining = data.get('remainingQuantity', null);
      let quantity = data.get('quantity', null);
      let photo = data.get('photo', null);
      return data.keys().hasOnly([
               'campaignId', 'species', 'provider', 'treatment',
               'totalQuantity', 'remainingQuantity', 'quantity', 'photo', 'assignedSeeds',
               'userAssignments', 'deleted', 'createdAt'
             ]) &&
             data.keys().hasAll(['campaignId', 'species']) &&
             validString(data.campaignId, 1, 128) &&
             validString(data.species, 1, 200) &&
             (provider == null || (provider is string && provider.size() <= 200)) &&
             (treatment == null || (treatment is string && treatment.size() <= 500)) &&
             (!('totalQuantity' in data) || (data.totalQuantity is number && data.totalQuantity >= 0 && data.totalQuantity <= 1000000)) &&
             (remaining == null || (remaining is number && remaining >= 0 && remaining <= 1000000)) &&
             (quantity == null || (quantity is string && quantity.size() <= 50) || (quantity is number && quantity >= 0 && quantity <= 1000000)) &&
             (photo == null || photo == '' || (photo is string && photo.size() <= 350000 && (photo.matches("^data:image/.*") || isValidUrl(photo)))) &&
             (!('assignedSeeds' in data) || (data.assignedSeeds is list && data.assignedSeeds.size() <= 500)) &&
             (!('userAssignments' in data) || (data.userAssignments is list && data.userAssignments.size() <= 500)) &&
             (!('deleted' in data) || data.deleted is bool) &&
             (!('createdAt' in data) || data.createdAt is timestamp);
    }

    function isValidGroup(data) {
      return data.keys().hasOnly([
               'campaignId', 'name', 'assignedSeeds', 'createdAt'
             ]) &&
             data.keys().hasAll(['campaignId', 'name']) &&
             validString(data.campaignId, 1, 128) &&
             validString(data.name, 1, 200) &&
             (!('assignedSeeds' in data) || (data.assignedSeeds is list && data.assignedSeeds.size() <= 500)) &&
             (!('createdAt' in data) || data.createdAt is timestamp);
    }

    function isValidLocationMap(loc) {
      let lat = loc.get('lat', null);
      let lng = loc.get('lng', null);
      let acc = loc.get('acc', null);
      return loc.keys().hasOnly(['lat', 'lng', 'acc']) &&
             (lat == null || lat is number) &&
             (lng == null || lng is number) &&
             (acc == null || acc is number);
    }

    function isValidLocation(loc) {
      return loc == null ||
             loc is latlng ||
             (loc is map && isValidLocationMap(loc));
    }

    function isValidLogCheckupSummary(data) {
      let updatedAt = data.get('updatedAt', null);
      let status = data.get('lastCheckupStatus', null);
      let checkupAt = data.get('lastCheckupAt', null);
      let surviving = data.get('lastSurvivingCount', null);
      let stage = data.get('lastGrowthStage', null);
      let count = data.get('checkupCount', null);
      let by = data.get('lastCheckupBy', null);
      return (updatedAt == null || updatedAt is timestamp) &&
             (status == null || (status is string && status in ['alive', 'dormant', 'dead', 'predated', 'not_found'])) &&
             (checkupAt == null || checkupAt is timestamp) &&
             (surviving == null || (surviving is int && surviving >= 0 && surviving <= 1000)) &&
             (stage == null || (stage is string && stage in ['cotyledons', 'seedling', 'juvenile', 'established'])) &&
             (count == null || (count is int && count >= 0 && count <= 10000)) &&
             (by == null || (by is string && by.size() <= 150));
    }

    function isValidLogCoreFields(data) {
      let holeCount = data.get('holeCount', null);
      let quantity = data.get('quantity', null);
      let microsite = data.get('microsite', null);
      let orientation = data.get('orientation', null);
      let withSubstrate = data.get('withSubstrate', null);
      let withProtector = data.get('withProtector', null);
      return validString(data.campaignId, 1, 128) &&
             (data.seedId == null || validString(data.seedId, 1, 128)) &&
             (data.seedName == null || validString(data.seedName, 1, 200)) &&
             (holeCount == null || (holeCount is int && holeCount >= 1 && holeCount <= 1000)) &&
             (quantity == null || (quantity is string && quantity.size() <= 50) || (quantity is number && quantity >= 0 && quantity <= 10000)) &&
             (microsite == null || (microsite is string && microsite.size() <= 100)) &&
             (orientation == null || (orientation is string && orientation.size() <= 50)) &&
             (withSubstrate == null || withSubstrate is bool) &&
             (withProtector == null || withProtector is bool);
    }

    function isValidLogMetaFields(data) {
      let notes = data.get('notes', null);
      let photoUrl = data.get('photoUrl', null);
      let syncStatus = data.get('syncStatus', null);
      let groupId = data.get('groupId', null);
      let groupName = data.get('groupName', null);
      let ownerId = data.get('ownerId', null);
      let userName = data.get('userName', null);
      return (notes == null || (notes is string && notes.size() <= 2000)) &&
             isValidLocation(data.get('location', null)) &&
             (photoUrl == null || photoUrl == '' || photoUrl == 'PENDING' || (isValidUrl(photoUrl) && photoUrl.size() <= 2048)) &&
             (syncStatus == null || syncStatus in ['synced', 'pending_photo']) &&
             (groupId == null || (groupId is string && groupId.size() <= 128)) &&
             (groupName == null || (groupName is string && groupName.size() <= 150)) &&
             (data.userId == null || validString(data.userId, 1, 128)) &&
             (ownerId == null || validString(ownerId, 1, 128)) &&
             (userName == null || (userName is string && userName.size() <= 150)) &&
             data.timestamp is timestamp;
    }

    function isValidLogCommon(data) {
      return isValidLogCoreFields(data) && isValidLogMetaFields(data);
    }

    function isValidLogCreate(data) {
      let ownerId = data.get('ownerId', null);
      return data.keys().hasOnly([
               'campaignId', 'seedId', 'seedName', 'holeCount', 'quantity',
               'microsite', 'orientation', 'withSubstrate', 'withProtector',
               'notes', 'location', 'photoUrl', 'syncStatus', 'groupId',
               'groupName', 'userId', 'ownerId', 'userName', 'timestamp'
             ]) &&
             data.keys().hasAll(['campaignId', 'seedId', 'seedName', 'holeCount', 'userId', 'timestamp']) &&
             data.seedId != null &&
             data.seedName != null &&
             data.holeCount != null &&
             data.userId == request.auth.uid &&
             (ownerId == null || ownerId == request.auth.uid) &&
             isValidLogCommon(data);
    }

    function isLogCheckupSummaryOnly(affectedKeys) {
      return affectedKeys.hasOnly([
        'lastCheckupStatus', 'lastCheckupAt', 'lastSurvivingCount',
        'lastGrowthStage', 'checkupCount', 'lastCheckupBy', 'updatedAt'
      ]);
    }

    function isValidLogUpdateCore(newData, oldData, diff, summaryOnly) {
      let newKeys = newData.keys();
      return newKeys.hasOnly([
               'campaignId', 'seedId', 'seedName', 'holeCount', 'quantity',
               'microsite', 'orientation', 'withSubstrate', 'withProtector',
               'notes', 'location', 'photoUrl', 'syncStatus', 'groupId',
               'groupName', 'userId', 'ownerId', 'userName', 'timestamp',
               'updatedAt', 'photo', 'uid', 'method',
               'lastCheckupStatus', 'lastCheckupAt', 'lastSurvivingCount',
               'lastGrowthStage', 'checkupCount', 'lastCheckupBy'
             ]) &&
             newKeys.hasAll(['campaignId', 'seedId', 'seedName', 'userId', 'timestamp']) &&
             !diff.addedKeys().hasAny(['photo', 'uid', 'method']) &&
             !diff.changedKeys().hasAny(['photo', 'uid', 'method']) &&
             isValidLogCheckupSummary(newData) &&
             (
               summaryOnly ||
               (
                 (!('holeCount' in oldData) || oldData.holeCount == null || newData.get('holeCount', null) is int) &&
                 isValidLogCommon(newData)
               )
             );
    }

    function isValidLogUpdate(newData, oldData) {
      let diff = newData.diff(oldData);
      let summaryOnly = isLogCheckupSummaryOnly(diff.affectedKeys());
      return isValidLogUpdateCore(newData, oldData, diff, summaryOnly);
    }

    function canUpdateLog(appId, newData, oldData) {
      let diff = newData.diff(oldData);
      let affected = diff.affectedKeys();
      let summaryOnly = isLogCheckupSummaryOnly(affected);
      let realUser = isRealUser();
      let campId = oldData.get('campaignId', null);
      return isValidLogUpdateCore(newData, oldData, diff, summaryOnly) &&
             (
               (realUser && hasAdminDoc()) ||
               (
                 (summaryOnly || !affected.hasAny(['campaignId', 'userId', 'ownerId', 'timestamp'])) &&
                 (
                   (realUser && isLogOwner(oldData)) ||
                   (
                     campId != null &&
                     campaignExists(appId, campId) &&
                     canManageOrReviewLogCampaign(appId, campId, summaryOnly, realUser)
                   )
                 )
               )
             );
    }

    function isValidCausesList(causes) {
      return causes == null ||
             (
               causes is list &&
               causes.size() <= 10 &&
               (causes.size() < 1 || validString(causes[0], 1, 100)) &&
               (causes.size() < 2 || validString(causes[1], 1, 100)) &&
               (causes.size() < 3 || validString(causes[2], 1, 100)) &&
               (causes.size() < 4 || validString(causes[3], 1, 100)) &&
               (causes.size() < 5 || validString(causes[4], 1, 100)) &&
               (causes.size() < 6 || validString(causes[5], 1, 100)) &&
               (causes.size() < 7 || validString(causes[6], 1, 100)) &&
               (causes.size() < 8 || validString(causes[7], 1, 100)) &&
               (causes.size() < 9 || validString(causes[8], 1, 100)) &&
               (causes.size() < 10 || validString(causes[9], 1, 100))
             );
    }

    function isValidCheckup(data) {
      let surviving = data.get('survivingCount', null);
      let stage = data.get('growthStage', null);
      let causes = data.get('causes', null);
      let notes = data.get('notes', null);
      let photoUrl = data.get('photoUrl', null);
      let reviewerName = data.get('reviewerName', null);
      return data.keys().hasOnly([
               'campaignId', 'logId', 'status', 'survivingCount', 'growthStage',
               'causes', 'notes', 'photoUrl', 'reviewerId', 'reviewerName', 'timestamp'
             ]) &&
             data.keys().hasAll(['campaignId', 'logId', 'status', 'reviewerId', 'timestamp']) &&
             validString(data.campaignId, 1, 128) &&
             validString(data.logId, 1, 128) &&
             data.status is string &&
             data.status in ['alive', 'dormant', 'dead', 'predated', 'not_found'] &&
             (surviving == null || (surviving is int && surviving >= 0 && surviving <= 1000)) &&
             (stage == null || (stage is string && stage in ['cotyledons', 'seedling', 'juvenile', 'established'])) &&
             isValidCausesList(causes) &&
             (notes == null || (notes is string && notes.size() <= 2000)) &&
             (photoUrl == null || photoUrl == '' || (isValidUrl(photoUrl) && photoUrl.size() <= 2048)) &&
             validString(data.reviewerId, 1, 128) &&
             (reviewerName == null || (reviewerName is string && reviewerName.size() <= 150)) &&
             data.timestamp is timestamp;
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    // Admins allowlist: users can check their own admin status; no client writes
    match /admins/{userId} {
      allow read: if isRealOwner(userId) || isAdmin();
      allow write: if false;
    }

    // User profiles: readable by signed-in users (SocialView/CampaignDashboard/CampaignManager);
    // writes restricted to non-anonymous owner or admin with strict schema & role lockdown
    match /users/{userId} {
      allow read: if isSignedIn();

      allow create: if request.resource != null &&
                    isValidUser(request.resource.data) &&
                    (
                      isAdmin() ||
                      (isRealOwner(userId) && request.resource.data.defaultRole == 'sower')
                    );

      allow update: if request.resource != null &&
                    resource != null &&
                    isValidUser(request.resource.data) &&
                    (
                      isAdmin() ||
                      (
                        isRealOwner(userId) &&
                        areImmutableFieldsUnchanged(['defaultRole', 'email', 'createdAt'])
                      )
                    );

      allow delete: if isRealOwner(userId) || isAdmin();
    }

    // Direct messages: only authenticated non-anonymous sender or receiver can read;
    // sender can create up to 500 chars; messages are immutable once sent
    match /messages/{messageId} {
      allow read: if isRealUser() &&
                  resource != null &&
                  (resource.data.senderId == request.auth.uid ||
                   resource.data.receiverId == request.auth.uid);

      allow create: if isRealUser() &&
                    request.resource != null &&
                    isValidMessage(request.resource.data);

      allow update, delete: if false;
    }

    // Social follows graph: non-anonymous users manage only their own follow edges
    match /follows/{followId} {
      allow read: if isRealUser();

      allow create: if isRealUser() &&
                    request.resource != null &&
                    isValidFollow(request.resource.data, followId);

      allow update: if isRealUser() &&
                    request.resource != null &&
                    resource != null &&
                    resource.data.followerId == request.auth.uid &&
                    areImmutableFieldsUnchanged(['followerId', 'followingId']) &&
                    isValidFollow(request.resource.data, followId);

      allow delete: if isRealUser() &&
                    resource != null &&
                    resource.data.followerId == request.auth.uid;
    }

    // Historical log claim requests: owner or admin reads; real user creates pending request; admin approves/rejects
    match /claimRequests/{requestId} {
      allow read: if resource != null &&
                  (isRealOwner(resource.data.userId) || isAdmin());

      allow create: if isRealUser() &&
                    request.resource != null &&
                    request.resource.data.userId == request.auth.uid &&
                    request.resource.data.status == 'pending' &&
                    hasRequiredFields(['campaignIds', 'createdAt']) &&
                    isValidClaimRequest(request.resource.data);

      allow update: if isAdmin() &&
                    request.resource != null &&
                    resource != null &&
                    isValidClaimRequest(request.resource.data) &&
                    areImmutableFieldsUnchanged(['userId', 'logIds', 'campaignIds', 'createdAt']);

      allow delete: if false;
    }

    // ===============================================================
    // Campaign Artifacts Structure (/artifacts/{appId}/public/data/*)
    // ===============================================================

    match /artifacts/{appId}/public/data/campaigns/{campId} {
      // Unfiltered LandingPage queries require collection-wide signed-in read access
      allow read: if isSignedIn();

      // Create: real users with own ownerId (or admin), or signed-in legacy create without ownerId
      allow create: if isSignedIn() &&
                    request.resource != null &&
                    isValidCampaign(request.resource.data) &&
                    request.resource.data.name.size() >= 1 &&
                    'createdAt' in request.resource.data &&
                    (
                      isAdmin() ||
                      !('ownerId' in request.resource.data) ||
                      (isRealUser() && request.resource.data.ownerId == request.auth.uid)
                    );

      // Update: admin, legacy campaign (without ownerId), owner, coordinator (locked down), or self-join (?join=)
      allow update: if request.resource != null &&
                    resource != null &&
                    isValidCampaign(request.resource.data) &&
                    (
                      isAdmin() ||
                      (
                        isSignedIn() &&
                        isLegacyCampaignData(resource.data) &&
                        areImmutableFieldsUnchanged(['ownerId', 'createdAt'])
                      ) ||
                      (
                        isRealUser() &&
                        'ownerId' in resource.data &&
                        resource.data.ownerId == request.auth.uid &&
                        areImmutableFieldsUnchanged(['ownerId', 'createdAt'])
                      ) ||
                      (
                        isRealUser() &&
                        'coordinators' in resource.data &&
                        resource.data.coordinators is list &&
                        request.auth.uid in resource.data.coordinators &&
                        areImmutableFieldsUnchanged(['ownerId', 'coordinators', 'createdAt'])
                      ) ||
                      isValidSelfJoin(request.resource.data, resource.data)
                    );

      // Delete: admin, owner, or signed-in legacy campaign without ownerId
      allow delete: if resource != null && (
                      isAdmin() ||
                      (isSignedIn() && isLegacyCampaignData(resource.data)) ||
                      (isRealUser() && 'ownerId' in resource.data && resource.data.ownerId == request.auth.uid)
                    );
    }

    match /artifacts/{appId}/public/data/seeds/{seedId} {
      allow read: if isSignedIn();

      allow create: if request.resource != null &&
                    isValidSeed(request.resource.data) &&
                    'createdAt' in request.resource.data &&
                    (isAdmin() || isCampaignManager(appId, request.resource.data.campaignId));

      allow update: if request.resource != null &&
                    resource != null &&
                    isValidSeed(request.resource.data) &&
                    (
                      isAdmin() ||
                      (
                        (!('campaignId' in resource.data) || request.resource.data.campaignId == resource.data.campaignId) &&
                        areImmutableFieldsUnchanged(['createdAt']) &&
                        isCampaignManager(appId, request.resource.data.campaignId)
                      )
                    );

      allow delete: if resource != null && (
                      isAdmin() ||
                      ('campaignId' in resource.data &&
                       resource.data.campaignId != null &&
                       isCampaignManager(appId, resource.data.campaignId))
                    );
    }

    match /artifacts/{appId}/public/data/groups/{groupId} {
      allow read: if isSignedIn();

      allow create: if request.resource != null &&
                    isValidGroup(request.resource.data) &&
                    'createdAt' in request.resource.data &&
                    (isAdmin() || isCampaignManager(appId, request.resource.data.campaignId));

      allow update: if request.resource != null &&
                    resource != null &&
                    isValidGroup(request.resource.data) &&
                    (
                      isAdmin() ||
                      (
                        (!('campaignId' in resource.data) || request.resource.data.campaignId == resource.data.campaignId) &&
                        areImmutableFieldsUnchanged(['createdAt']) &&
                        isCampaignManager(appId, request.resource.data.campaignId)
                      )
                    );

      allow delete: if resource != null && (
                      isAdmin() ||
                      ('campaignId' in resource.data &&
                       resource.data.campaignId != null &&
                       isCampaignManager(appId, resource.data.campaignId))
                    );
    }

    match /artifacts/{appId}/public/data/logs/{logId} {
      allow read: if isSignedIn();

      // Create: real users in any existing campaign, or signed-in users in legacy campaigns without ownerId
      allow create: if request.resource != null &&
                    isValidLogCreate(request.resource.data) &&
                    campaignExists(appId, request.resource.data.campaignId) &&
                    (
                      isAdmin() ||
                      isRealUser() ||
                      (isSignedIn() && isLegacyCampaign(appId, request.resource.data.campaignId))
                    );

      // Update: admin, log owner (userId or ownerId), campaign manager (owner/coordinator/legacy),
      // or authorized campaign reviewer updating only checkup summary fields
      allow update: if isSignedIn() &&
                    request.resource != null &&
                    resource != null &&
                    canUpdateLog(appId, request.resource.data, resource.data);

      // Delete: admin, log owner (userId or ownerId), or campaign manager (owner/coordinator/legacy)
      allow delete: if resource != null && (
                      isAdmin() ||
                      (isRealUser() && isLogOwner(resource.data)) ||
                      (
                        'campaignId' in resource.data &&
                        resource.data.campaignId != null &&
                        (
                          (isSignedIn() && isLogOwner(resource.data) && isLegacyCampaign(appId, resource.data.campaignId)) ||
                          isCampaignManager(appId, resource.data.campaignId)
                        )
                      )
                    );
    }

    match /artifacts/{appId}/public/data/checkups/{checkupId} {
      allow read: if isSignedIn();

      allow create: if isRealUser() &&
                    request.resource != null &&
                    isValidCheckup(request.resource.data) &&
                    request.resource.data.reviewerId == request.auth.uid &&
                    canReviewCampaign(appId, request.resource.data.campaignId);

      allow update: if isRealUser() &&
                    request.resource != null &&
                    resource != null &&
                    isValidCheckup(request.resource.data) &&
                    areImmutableFieldsUnchanged(['campaignId', 'logId', 'reviewerId', 'timestamp']) &&
                    (
                      isAdmin() ||
                      isRealOwner(resource.data.reviewerId) ||
                      (
                        'campaignId' in resource.data &&
                        resource.data.campaignId != null &&
                        isCampaignManager(appId, resource.data.campaignId)
                      )
                    );

      allow delete: if isRealUser() &&
                    resource != null &&
                    (
                      isAdmin() ||
                      isRealOwner(resource.data.reviewerId) ||
                      (
                        'campaignId' in resource.data &&
                        resource.data.campaignId != null &&
                        isCampaignManager(appId, resource.data.campaignId)
                      )
                    );
    }

    // Default deny for all unmatched paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
